PORT=3000
# Local dev database ( untracked .env overrides these; see .gitignore )
POSTGRES_USER=deploykit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=deploykit
DATABASE_URL=postgresql://deploykit:change-me@postgres:5432/deploykit
# Phase 04 GitHub App (required for webhooks + private repos; leave unset to disable)
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_WEBHOOK_SECRET=change-me-webhook-secret
# GITHUB_API_BASE_URL=https://api.github.com
# GITHUB_INSTALLATION_ID=
# Phase 06 local image registry (development-only, unauthenticated,
# internal-network-only; leave HOST unset to keep local --load builds)
# DEPLOYKIT_REGISTRY_HOST=deploykit-registry:5000
# DEPLOYKIT_REGISTRY_NAMESPACE=deploykit
# DEPLOYKIT_REGISTRY_INSECURE=true is LOCAL DEVELOPMENT ONLY (loopback /
# deploykit-registry hostnames only); production must use false + TLS.
# DEPLOYKIT_REGISTRY_INSECURE=true
# Phase 09 observability (bounded persistent logs; see README Phase 09)
# DEPLOYKIT_LOG_RETENTION_DAYS=30
# DEPLOYKIT_LOG_MAX_LINES_PER_DEPLOYMENT=2000
# DEPLOYKIT_LOG_MAX_BYTES_PER_DEPLOYMENT=1048576
# DEPLOYKIT_LOG_MAX_MESSAGE_BYTES=8192
# Phase 10 identity/sessions (see README Phase 10)
# Comma-separated exact frontend origins for CORS + CSRF checks.
# Required in production (NODE_ENV=production); dev defaults to the vite ports.
# DEPLOYKIT_WEB_ORIGIN=https://deploykit.example.com
# DEPLOYKIT_SESSION_DAYS=7
# DEPLOYKIT_COOKIE_SECURE=true (default follows NODE_ENV: true in production)
# DEPLOYKIT_ALLOW_PUBLIC_REGISTRATION=false (first user on an empty DB can always register)
# DEPLOYKIT_AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# DEPLOYKIT_AUTH_RATE_LIMIT_MAX_ATTEMPTS=30
# DEPLOYKIT_AUTH_RATE_LIMIT_EMAIL_MAX_ATTEMPTS=10
# Phase 11 TLS/ACME (custom domains; see README Phase 11)
# Account email for the ACME CA (required before any issuance; staging can
# use any valid address). The worker marks requests failed with a visible
# error until this is set.
# DEPLOYKIT_ACME_EMAIL=ops@example.com
# ACME directory URL. Defaults to Let's Encrypt STAGING (safe). Set the
# production URL only on a publicly reachable host with DNS pointed at it.
# DEPLOYKIT_ACME_SERVER=https://acme-v02.api.letsencrypt.org/directory
# Certificate filesystem root (deploykit-certs volume in compose).
# DEPLOYKIT_CERTS_DIR=/certs
# Issuance backend: "acme" (lego, default) or "self-signed" (LOCAL DEV ONLY,
# refused when NODE_ENV=production, never valid for public trust).
# DEPLOYKIT_TLS_MODE=acme
# lego binary path override (worker image ships lego at /usr/local/bin).
# DEPLOYKIT_LEGO_BINARY=lego
# Certificate sweep interval for the worker (expiry, renewal claims, GC).
# DEPLOYKIT_CERT_POLL_INTERVAL_MS=60000
