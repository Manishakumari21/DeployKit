PORT=3000
# Local dev database ( untracked .env overrides these; see .gitignore )
POSTGRES_USER=deploykit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=deploykit
DATABASE_URL=postgresql://deploykit:change-me@postgres:5432/deploykit
# Phase 04 GitHub App (required for webhooks + private repos; leave unset to disable)
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_WEBHOOK_SECRET=change-me-webhook-secret
# GITHUB_API_BASE_URL=https://api.github.com
# GITHUB_INSTALLATION_ID=
# Phase 06 local image registry (development-only, unauthenticated,
# internal-network-only; leave HOST unset to keep local --load builds)
# DEPLOYKIT_REGISTRY_HOST=deploykit-registry:5000
# DEPLOYKIT_REGISTRY_NAMESPACE=deploykit
# DEPLOYKIT_REGISTRY_INSECURE=true is LOCAL DEVELOPMENT ONLY (loopback /
# deploykit-registry hostnames only); production must use false + TLS.
# DEPLOYKIT_REGISTRY_INSECURE=true
# Phase 09 observability (bounded persistent logs; see README Phase 09)
# DEPLOYKIT_LOG_RETENTION_DAYS=30
# DEPLOYKIT_LOG_MAX_LINES_PER_DEPLOYMENT=2000
# DEPLOYKIT_LOG_MAX_BYTES_PER_DEPLOYMENT=1048576
# DEPLOYKIT_LOG_MAX_MESSAGE_BYTES=8192
