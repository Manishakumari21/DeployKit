{
  "name": "deploykit",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "test": "npm run test --workspace=apps/api && npm run test --workspace=apps/web",
    "test:api": "npm run test --workspace=apps/api",
    "test:web": "npm run test --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "lint:web": "npm run lint --workspace=apps/web",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:reconcile": "npm run db:reconcile --workspace=apps/api"
  }
}
