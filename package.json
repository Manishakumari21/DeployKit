{
  "name": "deploykit",
  "private": true,
  "scripts": {
    "build": "npm --prefix apps/api run build && npm --prefix apps/web run build",
    "build:api": "npm --prefix apps/api run build",
    "build:web": "npm --prefix apps/web run build",
    "test": "npm --prefix apps/api test && npm --prefix apps/web test",
    "test:api": "npm --prefix apps/api test",
    "test:web": "npm --prefix apps/web test",
    "lint": "npm --prefix apps/web run lint",
    "lint:web": "npm --prefix apps/web run lint",
    "db:migrate": "npm --prefix apps/api run db:migrate",
    "db:reconcile": "npm --prefix apps/api run db:reconcile --"
  }
}
