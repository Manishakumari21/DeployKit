# DeployKit edge agent (Phase 12.5): standalone executor, no central
# API/worker responsibilities. Polls the control plane with a machine
# credential and runs edge-targeted deployments against the host Docker
# Engine via the mounted socket.
#
# Reproducibility mirrors Dockerfile.worker (node:22-alpine, npm ci from
# the committed lockfile). Only the Docker CLI is installed: the agent
# never checks out source, never builds images, and never issues
# certificates, so git/buildx/lego are intentionally absent.
FROM node:22-alpine

WORKDIR /app

RUN apk add --no-cache docker-cli \
    && addgroup -S edgeagent 2>/dev/null || true \
    && adduser -S -G edgeagent edgeagent 2>/dev/null || true

COPY package*.json ./

RUN npm ci --omit=dev

COPY tsconfig.json ./
COPY src ./src

RUN npm run build \
    && npm cache clean --force

# Non-root execution. NOTE: the container still needs read/write access to
# the Docker socket (mounted at runtime, never baked in). Whoever can call
# the Docker daemon effectively controls the host; see docs/edge-agent.md.
# If the socket is owned by root:docker, grant access with
# `--group-add <docker-gid>` at run time rather than running as root.
USER edgeagent

# No EXPOSE: the agent makes outbound connections only and publishes no
# inbound port. No credentials, tokens, or build secrets are baked in;
# DEPLOYKIT_AGENT_TOKEN must be supplied at run time (env or file).

CMD ["node", "dist/edgeAgent.js"]
